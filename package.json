{
  "name": "aw-browser-cleaner",
  "version": "1.3.0",
  "private": true,
  "description": "Chrome extension to selectively clear site data for a specific origin",
  "scripts": {
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bun test tests/e2e tests/automation --timeout 60000",
    "lint": "eslint *.js --ignore-pattern 'node_modules/**'",
    "check:version": "bun scripts/check-version.js",
    "check:permissions": "bun scripts/check-permissions.js",
    "build:package": "bun scripts/build-package.js",
    "validate:package": "bun scripts/validate-package.js",
    "upload:cws": "bun scripts/upload-cws.js",
    "setup:cws": "bun scripts/setup-cws-credentials.js"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.6",
    "eslint": "^10.13.0",
    "fast-check": "4.10.2",
    "globals": "^17.13.0",
    "puppeteer": "25.16.0"
  },
  "author": "AhliWeb.com",
  "license": "MIT"
}
