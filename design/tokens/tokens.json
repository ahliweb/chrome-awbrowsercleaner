{
  "$description": "AW Browser Cleaner design tokens v1.3. Implementation source of truth: styles.css (:root and prefers-color-scheme: dark). Keep both in sync.",
  "color": {
    "bg": { "light": "#FFFFFF", "dark": "#0B0F17", "$description": "Page background" },
    "surface": { "light": "#F9FAFB", "dark": "#111827", "$description": "Panels, footer" },
    "surface-muted": { "light": "#F3F4F6", "dark": "#1F2937", "$description": "Segmented control track, tags" },
    "border": { "light": "#E5E7EB", "dark": "#2B3442" },
    "border-strong": { "light": "#D1D5DB", "dark": "#3B4554", "$description": "Inputs, secondary buttons" },
    "text": { "light": "#111827", "dark": "#F3F4F6" },
    "text-label": { "light": "#374151", "dark": "#D1D5DB" },
    "text-secondary": { "light": "#4B5563", "dark": "#9CA3AF" },
    "text-tertiary": { "light": "#6B7280", "dark": "#9CA3AF" },
    "accent": { "light": "#1D4ED8", "dark": "#60A5FA", "$description": "Primary action; taken from the logo blue. 6.7:1 on white" },
    "accent-hover": { "light": "#1E40AF", "dark": "#93C5FD" },
    "accent-subtle": { "light": "#EFF6FF", "dark": "#172554" },
    "focus-ring": { "light": "#93C5FD", "dark": "#60A5FA" },
    "scope-exact": { "light": "#15803D", "dark": "#4ADE80", "$description": "Cleanup limited to the exact origin" },
    "scope-exact-bg": { "light": "#F0FDF4", "dark": "#052E16" },
    "scope-wide": { "light": "#B45309", "dark": "#FBBF24", "$description": "Scope wider than the origin (registrable-domain cookies)" },
    "scope-wide-text": { "light": "#92400E", "dark": "#FCD34D" },
    "scope-wide-bg": { "light": "#FFFBEB", "dark": "#2A1D06" },
    "danger": { "light": "#B91C1C", "dark": "#F87171", "$description": "Destructive across origins only" },
    "danger-bg": { "light": "#FEF2F2", "dark": "#2A0A0A" }
  },
  "font": {
    "family": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "scale": {
      "title": { "size": "16px", "weight": 600 },
      "header": { "size": "14px", "weight": 600 },
      "body": { "size": "13px", "weight": 400 },
      "label": { "size": "12px", "weight": 600 },
      "caption": { "size": "12px", "weight": 400 },
      "mono": { "size": "12px", "weight": 400, "ligatures": "none" }
    }
  },
  "space": [4, 6, 8, 10, 12, 14, 16],
  "radius": { "sm": "4px", "md": "6px", "lg": "8px", "popup": "10px" },
  "shadow": { "sm": "0 1px 2px rgba(17, 24, 39, 0.12)" },
  "size": {
    "popup": { "width": "380px", "maxHeight": "600px" },
    "control": "32px",
    "row": "28-30px",
    "primaryAction": "36px"
  }
}
